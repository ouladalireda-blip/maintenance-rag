# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Secrets
.env

# Bases locales
*.db

# Caches des outils
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Document protégé par le droit d'auteur (© INRS) : jamais versionné
corpus/inrs/

# Caches locaux (modèle FlashRank, etc.)
.cache/

# Réponses complètes du LLM (extraits du guide © INRS) : jamais versionnées
evals/runs/

# Lots de questions en cours de rédaction (avant assemblage dans questions_test.yaml)
evals/drafts/

# Données locales de l'API (journal SQLite des requêtes)
data/

# Certificat racine PUBLIC d'un antivirus / proxy qui inspecte HTTPS (propre au poste) :
# jamais versionné. Seul certs/.keep l'est (le dossier doit exister pour le COPY des Dockerfiles).
certs/*
!certs/.keep
